  {
    "rule_id": "R10",
    "field": "Manufacturer Address",
    "keywords": [
      "manufactured by",
      "manufactured at",
      "packed by",
      "imported by",
      "address"
    ],
    "evidence_patterns": [
      "\\bp\\.?\\s*o\\.?\\s+box\\b",
      "\\b\\d{6}\\b",
      "\\b(?:email|e-mail)\\b",
      "\\b(?:call|phone|tel)\\b",
      "\\b(?:road|street|lane|nagar|industrial area)\\b"
    ],
    "minimum_evidence": 2,
    "description": "Manufacturer, packer or importer name and applicable address information should be displayed.",
    "manual_review": false
  },
  {
    "rule_id": "R11-13",
    "field": "Net Quantity",
    "keywords": [
      "net quantity",
      "net qty"
    ],
    "evidence_patterns": [
      "\\b\\d+(?:\\.\\d+)?\\s?(?:mg|g|kg|ml|l|litre|liter|pcs|pack)\\b"
    ],
    "description": "Net quantity should be declared using the applicable unit and should not be misleading.",
    "manual_review": true
  },
